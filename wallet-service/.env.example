# Wallet Service Environment Variables
NODE_ENV=development
PORT=3002

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/wallet_db

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# API Secret Key for Service-to-Service Communication
API_SECRET_KEY=your_api_secret_key_here

# Reward Service URL
REWARD_SERVICE_URL=http://localhost:3001

# Admin Panel URL
ADMIN_PANEL_URL=http://localhost:3000
# Customer JWT Secret (shared with Auth Service)
CUSTOMER_JWT_SECRET=auth_service_customer_jwt_secret_2024
