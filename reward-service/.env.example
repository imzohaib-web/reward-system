# Reward Service Environment Variables
NODE_ENV=development
PORT=3001

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/reward_db

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# API Secret Key for Service-to-Service Communication
API_SECRET_KEY=your_api_secret_key_here

# Wallet Service URL
WALLET_SERVICE_URL=http://localhost:3002

# Admin Panel URL
ADMIN_PANEL_URL=http://localhost:3000