# Auth Service Environment Variables
NODE_ENV=development
PORT=3003

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/auth_db

# JWT Secret for Customer tokens
JWT_SECRET=auth_service_customer_jwt_secret_2024
JWT_EXPIRES_IN=7d

# API Secret Key for Service-to-Service Communication
API_SECRET_KEY=auth_service_api_secret_2024

# Admin Panel URL
ADMIN_PANEL_URL=http://localhost:3000
